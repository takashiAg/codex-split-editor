#!/usr/bin/env python3
"""Internal shell-function target: launch interactive Codex in the chosen mux."""

from __future__ import annotations

import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path


DIRECT_COMMANDS = {
    "a", "agents", "app", "app-server", "apply", "archive", "cloud",
    "completion", "debug", "delete", "e", "exec", "exec-server", "features",
    "help", "login", "logout", "mcp", "migrate-nfs-db", "migrate-rollouts",
    "plugin", "queue", "remote-control", "review", "sandbox", "unarchive",
    "update", "doctor",
}
VALUE_OPTIONS = {
    "-a", "-c", "-C", "-i", "-m", "-p", "-s", "--add-dir", "--ask-for-approval",
    "--config", "--cd", "--disable", "--enable", "--image", "--local-provider",
    "--model", "--profile", "--remote", "--remote-auth-token-env", "--sandbox",
}


def data_dir() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "codex-split-editor"


def load_config() -> dict[str, str]:
    path = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "codex-split-editor/config.json"
    try:
        config = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Setup is incomplete. Run the plugin setup skill first ({path}): {exc}") from exc
    required = ("codex_bin", "backend", "layout", "editor")
    if any(not isinstance(config.get(key), str) or not config[key] for key in required):
        raise RuntimeError(f"Invalid setup configuration: {path}")
    if config["backend"] not in {"tmux", "zellij"} or config["layout"] not in {"horizontal", "vertical"}:
        raise RuntimeError(f"Invalid backend or layout in setup configuration: {path}")
    return config


def is_interactive_codex(args: list[str]) -> bool:
    if not (sys.stdin.isatty() and sys.stdout.isatty() and sys.stderr.isatty()):
        return False
    if any(arg in ("-h", "--help", "-V", "--version") for arg in args):
        return False
    first = None
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            break
        if arg in VALUE_OPTIONS:
            index += 2
            continue
        if any(arg.startswith(option + "=") for option in VALUE_OPTIONS if option.startswith("--")):
            index += 1
            continue
        if arg.startswith("-"):
            index += 1
            continue
        first = arg
        break
    if first in DIRECT_COMMANDS:
        return False
    return True


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    try:
        config = load_config()
    except RuntimeError as exc:
        print(f"codex-split-editor: {exc}", file=sys.stderr)
        return 2

    codex = config["codex_bin"]
    if not Path(codex).is_file() or not os.access(codex, os.X_OK):
        print(f"codex-split-editor: configured Codex executable is missing or not executable: {codex}. Run setup again.", file=sys.stderr)
        return 127
    if not is_interactive_codex(args):
        return subprocess.run([codex, *args], check=False).returncode

    env = os.environ.copy()
    helper = str(data_dir() / "codex-split-editor")
    env["VISUAL"] = shlex.join([helper])
    env["CODEX_SPLIT_EDITOR"] = config["editor"]
    env["CODEX_SPLIT_BACKEND"] = config["backend"]
    env["CODEX_SPLIT_LAYOUT"] = config["layout"]
    env["PATH"] = os.environ.get("PATH", "")
    if config["backend"] == "tmux" and env.get("TMUX"):
        return subprocess.run([codex, *args], env=env, check=False).returncode
    if config["backend"] == "zellij" and env.get("ZELLIJ"):
        return subprocess.run([codex, *args], env=env, check=False).returncode

    backend = config["backend"]
    if not shutil.which(backend):
        print(f"codex-split-editor: {backend} is required. Install it and rerun setup.", file=sys.stderr)
        return 2

    session = "cse-" + uuid.uuid4().hex[:10]
    # A mux server may predate this shell and carry stale PATH/HOME/CODEX_HOME
    # or credential variables. Pass the caller environment through a private
    # mode-0600 file, not argv or the server's inherited environment.
    payload = {"env": env, "argv": [codex, *args], "cwd": os.getcwd(), "backend": backend}
    fd, payload_name = tempfile.mkstemp(prefix="codex-split-launch-")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(payload, stream)
        bootstrap = (
            "import json,os,sys; p=sys.argv[1]; "
            "d=json.load(open(p)); os.unlink(p); "
            "mux=('TMUX','TMUX_PANE','ZELLIJ','ZELLIJ_PANE_ID'); "
            "[d['env'].pop(k,None) for k in mux]; "
            "active=('TMUX','TMUX_PANE') if d['backend']=='tmux' else ('ZELLIJ','ZELLIJ_PANE_ID'); "
            "d['env'].update({k:os.environ[k] for k in active if k in os.environ}); "
            "os.chdir(d['cwd']); "
            "os.execvpe(d['argv'][0],d['argv'],d['env'])"
        )
        wrapped = [sys.executable, "-c", bootstrap, payload_name]
        if backend == "tmux":
            try:
                created = subprocess.run([
                    "tmux", "new-session", "-d", "-s", session, "-c", os.getcwd(), "--", *wrapped,
                ], check=False)
                if created.returncode:
                    return created.returncode
                # Capture the scroll wheel in tmux so the terminal emulator
                # does not enter its own (possibly stale) scrollback buffer.
                # Terminal-side click-to-select is intentionally unavailable.
                configured = subprocess.run(
                    ["tmux", "set-option", "-t", session, "mouse", "on"], check=False
                )
                if configured.returncode:
                    subprocess.run(["tmux", "kill-session", "-t", session], check=False)
                    return configured.returncode
                return subprocess.run(["tmux", "attach-session", "-t", session], check=False).returncode
            except KeyboardInterrupt:
                return 130

        with tempfile.TemporaryDirectory(prefix="codex-split-zellij-") as config_dir:
            kdl = Path(config_dir) / "config.kdl"
            kdl.write_text(
                'show_startup_tips false\n'
                'show_release_notes false\n'
                'default_mode "locked"\n'
                'keybinds {\n'
                '    unbind "Ctrl g"\n'
                '    locked {\n'
                '        bind "Ctrl Alt g" { SwitchToMode "Normal"; }\n'
                '    }\n'
                '    shared_except "locked" {\n'
                '        bind "Ctrl Alt g" { SwitchToMode "Locked"; }\n'
                '    }\n'
                '}\n'
            )
            command = ["zellij", "--config", str(kdl), "attach", "--create", session,
                       "--close-on-exit", "--", *wrapped]
            try:
                return subprocess.run(command, check=False).returncode
            except KeyboardInterrupt:
                return 130
    finally:
        Path(payload_name).unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())
